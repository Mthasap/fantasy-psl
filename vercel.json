{
  "routes": [
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=30" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/points-cron", "schedule": "0 21 * * *" }
  ]
}
{
 "crons":[
  { "path":"/api/sync-fixtures","schedule":"0 4 * * *"},
  { "path":"/api/sync-player-stats","schedule":"0 5 * * *"},
  { "path":"/api/live-matches","schedule":"*/10 * * * *"}
 ]
}

